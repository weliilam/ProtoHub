  <tbody>
    <tr><td>YT001,YT002,YT003</td><td>YT001 / YT002 / YT003</td><td>查询到 3 个单号</td><td>英文逗号分隔</td></tr>
    <tr><td>YT001、YT002 YT003</td><td>YT001 / YT002 / YT003</td><td>查询到 3 个单号</td><td>顿号、空格分隔</td></tr>
    <tr><td>YT001；YT002; YT003</td><td>YT001 / YT002 / YT003</td><td>查询到 3 个单号</td><td>中英文分号分隔</td></tr>
